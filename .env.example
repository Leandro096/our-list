# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Features ──────────────────────────────────────────────────
# Controla si la ruta pública /rsvp está habilitada.
# Ponlo en "false" para desactivarla (retorna 404).
NEXT_PUBLIC_RSVP_ENABLED=true

# ── Stripe (test keys from dashboard.stripe.com/test/apikeys) ─
# Server-side secret key — NEVER expose to the client.
STRIPE_SECRET_KEY=sk_test_...
# Webhook secret — get it from: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Client-side publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
