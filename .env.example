# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Features ──────────────────────────────────────────────────
# Controla si la ruta pública /rsvp está habilitada.
# Ponlo en "false" para desactivarla (retorna 404).
NEXT_PUBLIC_RSVP_ENABLED=true

# ── Invitación real (/invitacion/<código>) ────────────────────
NEXT_PUBLIC_CEREMONY_TIME=
NEXT_PUBLIC_CEREMONY_VENUE=
NEXT_PUBLIC_RECEPTION_TIME=
NEXT_PUBLIC_RECEPTION_VENUE=
# Opcional: enlace exacto de Google Maps (si no, se busca el texto del lugar).
NEXT_PUBLIC_CEREMONY_MAPS_URL=
NEXT_PUBLIC_RECEPTION_MAPS_URL=
